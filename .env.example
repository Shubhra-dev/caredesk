# Node.js 24 LTS required. Copy to .env; never share your .env or API key.
PORT=4100
HOST=127.0.0.1
DB_PATH=./data/clinic.sqlite
APP_ORIGIN=http://localhost:5173

# Real AI: use a free-tier project/key from Google AI Studio.
# Free tier is limited and account/model eligibility can change.
# Keep billing disabled for zero-spend practice. No automatic paid fallback exists.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Existing OpenAI integration remains optional; selected only by AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Set BEFORE initializing an empty production database. Never use the demo database publicly.
INITIAL_ADMIN_PASSWORD=
# NODE_ENV=production

# Patient tools are enabled for fictional development data. Production defaults to disabled.
# Enable only after provider/data-handling review and deployment approval.
COPILOT_PATIENT_TOOLS_APPROVED=false
