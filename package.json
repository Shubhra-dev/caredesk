{
  "name": "clinic-operations",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/tests/*.test.js",
    "check": "npm run build && npm test && npm run test:ui",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write src server scripts tests docs README.md AGENTS.md vite.config.ts vitest.config.ts START_HERE.md",
    "format:check": "prettier --check src server scripts tests docs README.md AGENTS.md vite.config.ts vitest.config.ts START_HERE.md",
    "test:ui": "vitest run",
    "ai:check": "node --env-file-if-exists=.env scripts/check-ai.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
